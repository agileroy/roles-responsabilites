{
  "rules": {
    ".read": false,
    ".write": false,
    "rolesGame": {
      "expiry": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || (!newData.exists() && (data.child('hostUid').val() === auth.uid || data.child('createdAt').val() < now - 86400000)))",
          ".validate": "$code.matches(/^[A-HJKMNP-Z]{4}$/) && newData.hasChildren(['createdAt', 'hostUid'])",
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "hostUid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "rooms": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && (data.child('meta/hostUid').val() === auth.uid || !root.child('rolesGame/expiry/' + $code).exists() || root.child('rolesGame/expiry/' + $code + '/createdAt').val() < now - 86400000)",
          "meta": {
            ".write": "auth != null && ((!data.exists() && root.child('rolesGame/expiry/' + $code + '/hostUid').val() === auth.uid) || (data.exists() && data.child('hostUid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['hostUid', 'createdAt', 'status']) && newData.child('hostUid').val() === auth.uid",
            "hostUid": {
              ".validate": "newData.isString()"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === root.child('rolesGame/expiry/' + $code + '/createdAt').val()))"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(lobby|playing|finished)$/)"
            },
            "cardsPerPlayer": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 200"
            },
            "timerSeconds": {
              ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 30 || newData.val() === 45 || newData.val() === 60)"
            },
            "hands": {
              "$uid": {
                "$i": {
                  ".validate": "$i.matches(/^[0-9]{1,3}$/) && newData.isString() && newData.val().matches(/^[a-z0-9-]{1,20}$/)"
                }
              }
            },
            "playerOrder": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 128"
              }
            },
            "startedAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "finishedAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          },
          "players": {
            "$uid": {
              "name": {
                ".write": "auth != null && auth.uid === $uid && root.child('rolesGame/rooms/' + $code + '/meta').exists() && root.child('rolesGame/rooms/' + $code + '/meta/status').val() !== 'finished' && data.parent().child('removed').val() !== true",
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
              },
              "joinedAt": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "connections": {
                "$connId": {
                  ".write": "auth != null && auth.uid === $uid",
                  ".validate": "newData.val() === true"
                }
              },
              "quota": {
                ".write": "auth != null && root.child('rolesGame/rooms/' + $code + '/meta/hostUid').val() === auth.uid",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
              },
              "removed": {
                ".write": "auth != null && root.child('rolesGame/rooms/' + $code + '/meta/hostUid').val() === auth.uid",
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "names": {
            "$key": {
              ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
              ".validate": "newData.isString() && $key.length <= 200"
            }
          },
          "turn": {
            ".write": "auth != null && root.child('rolesGame/rooms/' + $code + '/meta/hostUid').val() === auth.uid",
            ".validate": "newData.hasChild('seq')",
            "seq": {
              ".validate": "newData.isNumber()"
            },
            "done": {
              ".validate": "newData.isBoolean()"
            },
            "playerUid": {
              ".validate": "newData.isString()"
            },
            "deckIndex": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}$/)"
            },
            "cardId": {
              ".write": "auth != null && auth.uid === data.parent().child('playerUid').val() && !data.exists() && root.child('rolesGame/rooms/' + $code + '/meta/status').val() === 'playing'",
              ".validate": "newData.isString() && newData.val() === root.child('rolesGame/rooms/' + $code + '/meta/hands').child(data.parent().child('playerUid').val()).child(data.parent().child('deckIndex').val()).val()"
            },
            "drawnAt": {
              ".write": "auth != null && auth.uid === data.parent().child('playerUid').val() && !data.exists()",
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "selection": {
              ".write": "auth != null && auth.uid === data.parent().child('playerUid').val() && data.parent().child('cardId').exists() && !data.parent().child('placement').exists()",
              ".validate": "newData.isString() && newData.val().matches(/^(po|sm|dev|po-sm|po-dev|sm-dev|team|trap)$/)"
            },
            "placement": {
              ".write": "auth != null && auth.uid === data.parent().child('playerUid').val() && data.parent().child('cardId').exists() && !data.exists() && !data.parent().child('revealed').exists() && (root.child('rolesGame/rooms/' + $code + '/meta/timerSeconds').val() === 0 || now <= data.parent().child('drawnAt').val() + root.child('rolesGame/rooms/' + $code + '/meta/timerSeconds').val() * 1000 + 2000)",
              ".validate": "newData.isString() && newData.val().matches(/^(po|sm|dev|po-sm|po-dev|sm-dev|team|trap)$/)"
            },
            "placedAt": {
              ".write": "auth != null && auth.uid === data.parent().child('playerUid').val() && !data.exists()",
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "revealed": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "results": {
            ".write": "auth != null && root.child('rolesGame/rooms/' + $code + '/meta/hostUid').val() === auth.uid",
            "$seq": {
              ".validate": "$seq.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['playerUid', 'cardId', 'verdict', 'timedOut'])",
              "playerUid": {
                ".validate": "newData.isString()"
              },
              "cardId": {
                ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,20}$/)"
              },
              "region": {
                ".validate": "newData.isString() && newData.val().matches(/^(po|sm|dev|po-sm|po-dev|sm-dev|team|trap)$/)"
              },
              "verdict": {
                ".validate": "newData.isString() && newData.val().matches(/^(right|partial|wrong)$/)"
              },
              "timedOut": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
